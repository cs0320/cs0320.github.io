{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{2}\\/\\d{2} [MWF]$"
      },
      "topic": {
        "type": "string",
        "minLength": 1
      },
      "notes": {
        "anyOf": [
          {
            "type": "string",
            "const": ""
          },
          {
            "type": "string",
            "format": "uri"
          }
        ]
      },
      "code": {
        "anyOf": [
          {
            "type": "string",
            "const": ""
          },
          {
            "type": "string",
            "format": "uri"
          }
        ]
      },
      "recording": {
        "anyOf": [
          {
            "type": "string",
            "const": ""
          },
          {
            "type": "string",
            "format": "uri"
          }
        ]
      },
      "readings": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "const": ""
                },
                {
                  "type": "string",
                  "format": "uri"
                }
              ]
            }
          },
          "required": [
            "title",
            "url"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "date",
      "topic",
      "notes",
      "code",
      "recording",
      "readings"
    ],
    "additionalProperties": false
  }
}
